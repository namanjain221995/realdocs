# RealtimeDocs configuration.
#
# `pnpm setup:env` copies this file to `.env` and fills in the two secrets.
# It never overwrites an existing `.env`. This file contains no secrets.
#
# The same `.env` is used by Docker Compose (database + server containers) and
# by the server when it runs on the host (`pnpm dev`, `pnpm start`, CLI commands).

# ── Required ────────────────────────────────────────────────────────────────

# Password of the PostgreSQL user that Docker Compose creates. Generated by `pnpm setup:env`.
POSTGRES_PASSWORD=

# At least 32 random characters. Generated by `pnpm setup:env`.
# Changing it signs nobody out, but every open browser tab has to reload once.
SESSION_SECRET=

# Database used by a server that runs on the host. (The server container gets
# its own URL from docker-compose.yml and ignores this line.)
DATABASE_URL=postgres://realtimedocs:POSTGRES_PASSWORD@127.0.0.1:54310/realtimedocs

# ── Addresses ───────────────────────────────────────────────────────────────

# Where the server listens. Docker Compose publishes RD_PORT on 127.0.0.1 only.
RD_HOST=127.0.0.1
RD_PORT=4310
# Host port of the PostgreSQL container (127.0.0.1 only).
RD_DB_PORT=54310

# The address people type into their browser, without a path. Use the https://
# address of your reverse proxy in a real deployment: generated share links,
# Secure cookies and HSTS follow from it.
PUBLIC_ORIGIN=http://127.0.0.1:4310

# Additional web origins that may use cookie sessions, comma separated.
# The Vite development server is listed so `pnpm dev` works out of the box.
# Leave this empty in a deployment that other people use: every origin listed
# here is trusted like PUBLIC_ORIGIN itself. `pnpm setup:env` keeps this value
# only when PUBLIC_ORIGIN is a loopback http address and writes an empty list
# when it is called with `--public-origin https://…`.
ALLOWED_ORIGINS=http://127.0.0.1:4311,http://localhost:4311

# Origin of the packaged desktop renderer (bearer tokens only, never cookies).
DESKTOP_ORIGINS=app://realtimedocs

# Set to the number of reverse proxies in front of the server (usually 1) so
# rate limits and logs see the real client address. Leave false without a proxy.
TRUST_PROXY=false

# ── Optional (defaults shown) ───────────────────────────────────────────────

# LOG_LEVEL=info
# AUTO_MIGRATE=true
# COOKIE_SECURE=auto
# ASSET_DIR=data/assets
# WEB_DIST_DIR=apps/web/dist
# Directory the desktop app downloads are served from (GET/HEAD /download/<file>).
# Only the fixed names realtimedocs-{windows,macos}-{x64,arm64}.zip are served.
# Unset means the landing page shows every desktop download as "not published yet".
# DOWNLOAD_DIR=data/downloads
# GET /api/downloads lists the files found there with size and SHA-256. An optional
# release.json in the same directory ({ "version": "...", "notes": "...", "signed": false })
# describes the release; "signed" is only what the operator states.
# Self-service sign-up on the login page. Trade-off: anyone who can reach the server could
# create an account, though it is a plain member and gets no document access until an
# administrator adds it. Off by default; the first administrator is always created by the CLI.
# ALLOW_SIGNUP=false
# MIN_CLIENT_SCHEMA_VERSION=1

# Session lifetimes in seconds: absolute and idle, per kind of session.
# SESSION_TTL_SECONDS=1209600
# SESSION_IDLE_TTL_SECONDS=259200
# SHARE_SESSION_TTL_SECONDS=604800
# SHARE_SESSION_IDLE_TTL_SECONDS=86400
# DESKTOP_SESSION_TTL_SECONDS=2592000
# DESKTOP_SESSION_IDLE_TTL_SECONDS=1209600

# Limits (bytes unless noted). The effective values are published at GET /api/meta.
# LIMIT_MAX_IMAGE_BYTES=10485760
# LIMIT_MAX_ATTACHMENT_BYTES=26214400
# LIMIT_MAX_SVG_BYTES=1048576
# LIMIT_MAX_IMAGE_PIXELS=40000000
# LIMIT_MAX_IMAGE_DIMENSION=12000
# LIMIT_DOCUMENT_ASSET_QUOTA_BYTES=524288000
# LIMIT_MAX_DOCUMENT_STATE_BYTES=8388608
# LIMIT_MAX_COLLAB_MESSAGE_BYTES=4194304
# LIMIT_MAX_JSON_BODY_BYTES=262144

# Retention.
# TRASH_RETENTION_DAYS=30
# ASSET_GRACE_DAYS=30
# PENDING_UPLOAD_HOURS=24
# PRE_RESTORE_SNAPSHOT_RETENTION_DAYS=90
# AUDIT_RETENTION_DAYS=365
# SESSION_RETENTION_DAYS=30
# Minutes between retention runs inside the server. 0 turns the timer off; then run
# `docker compose exec server realtimedocs cleanup` (or, on the host,
# `pnpm --filter @realtimedocs/server run cleanup`) from cron.
# CLEANUP_INTERVAL_MINUTES=360

# Collaboration endpoint.
# COLLAB_MAX_CONNECTIONS=1000
# Uncommitted update bytes per document before it stops accepting edits.
# COLLAB_MAX_QUEUE_BYTES=16777216
# Inbound frame budget per socket: burst and sustained frames per second.
# COLLAB_FRAME_BURST=1500
# COLLAB_FRAMES_PER_SECOND=300
# COLLAB_TICKET_TTL_SECONDS=60
# COLLAB_PING_INTERVAL_SECONDS=15
# COLLAB_IDLE_TIMEOUT_SECONDS=45
# COLLAB_SWEEP_INTERVAL_SECONDS=30
# COLLAB_COMPACT_AFTER_UPDATES=200

# Database pool and timeouts (milliseconds).
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_LOCK_TIMEOUT_MS=5000
# DB_CONNECT_TIMEOUT_MS=5000

# Rate limits (attempts per window; see docs/notes/server.md for the windows).
# RATE_LOGIN_PER_IP=20
# RATE_LOGIN_PER_EMAIL=8
# RATE_SHARE_EXCHANGE_PER_IP=30
# RATE_SHARE_EXCHANGE_PER_GRANT=20
# RATE_INVITE_PER_IP=20
# Sign-up attempts (counted when ALLOW_SIGNUP=true): per client address per 10 min, per email per hour.
# RATE_SIGNUP_PER_IP=10
# RATE_SIGNUP_PER_EMAIL=3
# RATE_DESKTOP_REDEEM_PER_IP=20
# RATE_COLLAB_TICKET_PER_MINUTE=120
# RATE_UPLOAD_PER_MINUTE=60
# RATE_WS_UPGRADE_PER_MINUTE=120
# RATE_API_PER_MINUTE=1200
