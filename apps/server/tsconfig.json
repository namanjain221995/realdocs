{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM typings are needed only because the shared contracts (typed browser
    // client) and the editor schema (HTML attribute parsers) are consumed as source.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src", "test", "scripts", "*.ts"]
}
