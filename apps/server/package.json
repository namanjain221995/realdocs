{
  "name": "@realtimedocs/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "migrate": "tsx src/cli.ts migrate",
    "bootstrap:admin": "tsx src/cli.ts bootstrap-admin",
    "reset:password": "tsx src/cli.ts reset-password",
    "seed:sample": "tsx src/cli.ts seed-sample",
    "cleanup": "tsx src/cli.ts cleanup",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:backup-restore": "bash test/backup-restore/run.sh",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@hocuspocus/server": "4.8.0",
    "@realtimedocs/contracts": "workspace:*",
    "@realtimedocs/editor": "workspace:*",
    "@tiptap/core": "3.32.3",
    "@tiptap/pm": "3.32.3",
    "@tiptap/y-tiptap": "3.2.0",
    "fastify": "5.12.8",
    "fflate": "0.8.3",
    "image-size": "2.1.0",
    "ioredis": "6.0.0",
    "lib0": "0.2.120",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "saxes": "6.0.0",
    "ws": "8.22.2",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.8.0",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2"
  }
}
