{
  "name": "@realtimedocs/load",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "stage": "node --import tsx src/stack.ts stage",
    "stack:up": "node --import tsx src/stack.ts up",
    "stack:down": "node --import tsx src/stack.ts down",
    "stack:status": "node --import tsx src/stack.ts status",
    "load": "node --import tsx src/run.ts"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.8.0",
    "@realtimedocs/contracts": "workspace:*",
    "@types/ws": "8.18.2",
    "lib0": "0.2.120",
    "ws": "8.22.2",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  }
}
